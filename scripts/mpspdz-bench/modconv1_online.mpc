import sys, os, random
sys.path.insert(0, os.path.join(os.getcwd(), 'Programs/Source'))

from modconv import (Inputs, read_from, read_vec_from, to_array, deal_modconv1, decrypt_batch_fused,
                     sample_lwe_key, decrypt_batch, warm_up, signed_t,
                     count_mismatches, warm_up_threads, Q)
from Compiler.types import sint
from Compiler.library import start_timer, stop_timer, print_ln

beta = int(program.args[1]) if len(program.args) > 1 else 2
batch = int(program.args[2]) if len(program.args) > 2 else 1
lwe_n = int(program.args[3]) if len(program.args) > 3 else 1024
threads = int(program.args[4]) if len(program.args) > 4 else 1
fused = int(program.args[5]) if len(program.args) > 5 else 0
s_bits = int(program.args[6]) if len(program.args) > 6 else 16
c_bits = int(program.args[7]) if len(program.args) > 7 else 34

bound = Q - Q // beta
sk = sample_lwe_key(lwe_n, s_bits, c_bits, bound)
mu = [random.randrange(2) for _ in range(batch)]
ms, us = deal_modconv1(beta, batch)

inputs = Inputs(1)
inputs.put_many(0, sk)
inputs.put_many(0, mu)
inputs.put_many(0, ms)
for i in range(beta):
    inputs.put_many(0, us[i])
inputs.flush()

sk_arr = sint.Array(lwe_n)
sk_arr.assign_vector(read_vec_from(0, lwe_n))
mu_arr = to_array(read_vec_from(0, batch), batch)
m_arr = to_array(read_vec_from(0, batch), batch)
u_arrs = [to_array(read_vec_from(0, batch), batch) for _ in range(beta)]

warm_up()
(decrypt_batch_fused if fused else decrypt_batch)(sk_arr, mu_arr, m_arr, u_arrs, beta, batch, c_bits, threads)

start_timer(1)
opened = (decrypt_batch_fused if fused else decrypt_batch)(sk_arr, mu_arr, m_arr, u_arrs, beta, batch, c_bits, threads)
stop_timer(1)

errors = count_mismatches(opened.get_vector(0, batch),
                          [signed_t(b * Q) for b in mu], batch)
print_ln('batch: %s  threads: %s', batch, threads)
print_ln('mismatches: %s', errors)
