import sys, os
sys.path.insert(0, os.path.join(os.getcwd(), 'Programs/Source'))

from modconv import (Inputs, read_from, deal_modconv3, online_compare,
                     check_result, warm_up, K_Q, Q)
from Compiler.library import start_timer, stop_timer, print_ln
import random

m, bits = deal_modconv3()
x = random.randrange(Q)

inputs = Inputs(1)
inputs.put_many(0, [x, m] + bits)
inputs.flush()

vals = read_from(0, 2 + K_Q)
x_share, m_share, bit_shares = vals[0], vals[1], vals[2:]

warm_up()

start_timer(1)
res, y = online_compare(x_share, m_share, bit_shares)
stop_timer(1)

check_result(res, x)
